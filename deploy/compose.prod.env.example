# Copy to deploy/compose.prod.env on the deployment server; never commit real values.
# Bare hostname only: no https://, port, path, wildcard or comma.
APP_DOMAIN=
# Two different random passwords, separate from all local and test credentials.
PROD_MYSQL_PASSWORD=''
PROD_MYSQL_ROOT_PASSWORD=''
# Optional: verified Caddy container IP/CIDR only. Empty means one shared proxy quota.
AUTH_TRUSTED_PROXIES=
# Optional compose.smtp.yaml only. Fill privately after verifying the sender with your provider.
RESET_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=''
SMTP_PASSWORD=''
