{
  "uid": "stockroom",
  "title": "STOCKROOM · Orders & Runtime",
  "description": "Local orders, authentication and runtime observability. Order events follow commit; auth results follow CSRF-valid HTTP outcomes. Counters reset on restart. No personal identifiers are metric labels.",
  "tags": [
    "stockroom",
    "local",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 4,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "SCRAPE · UP",
      "type": "stat",
      "description": "1 = scrape succeeds. No data or 0 means the app or collector needs inspection.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "stockroom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"stockroom\"}",
          "legendFormat": "UP",
          "datasource": {
            "type": "prometheus",
            "uid": "stockroom-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "CREATED · total",
      "type": "stat",
      "description": "Committed order creations, including requests without an idempotency key. Resets on app restart.",
