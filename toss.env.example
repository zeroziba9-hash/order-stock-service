# Copy to .local/toss-test.env; never commit the filled file.
# Individual API keys from the same Toss test application, not widget gck/gsk keys.
APP_TOSS_ENABLED=true
APP_TOSS_CLIENT_KEY=
APP_TOSS_SECRET_KEY=
# Exact browser origin, without a trailing slash. Loopback HTTP or HTTPS only.
APP_TOSS_ORIGIN=http://localhost:18087
